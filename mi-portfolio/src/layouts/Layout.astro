---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Diego Marchandon</title>
	</head>
	<body class="backgroundDarkMode">
		<slot />
		<script>
			const originalTitle = document.title;
			let timeoutId:any;

			document.addEventListener("visibilitychange", () => {
			if (document.hidden) {
				// espera unos segundos antes de cambiar el título
				timeoutId = setTimeout(() => {
				document.title = "👀 No me olviden";
				}, 5000);
			} else {
				// vuelve al título original cuando el usuario regresa
				clearTimeout(timeoutId);
				document.title = originalTitle;
			}
			});

			// variante con rotación de mensajes: 

