---
import styles from '../../styles/boxes.module.css';
import boxStyles from '../../styles/boxes/projects.module.css';
---

<div class={`${styles.boxStyles}`}>
    <div class={`${boxStyles.boxContainer}`}>
        
        <div class={`${boxStyles.iframeContainer}`}>
            <div class={`${boxStyles.titleWrapper}`}>
                <h3>Congresistas ARG</h3>
            </div>
            <div class={`${boxStyles.iframeWrapper}`}>
                <iframe
                class={`${boxStyles.iframe}`}
                src="https://congresistas-arg-hlfj.vercel.app/"
                loading="lazy"
                title="Vista previa del proyecto"
                >
                </iframe>
            </div>
            <div class={`${boxStyles.iframeInfo}`}>
                <div class={`${boxStyles.iframeDescription}`}>
                    <p>Plataforma que visualiza en tiempo real la 
                        composición y actividad de ambas cámaras del Congreso Argentino 
                        (Diputados y Senadores)
                    </p>
                </div>
                <div class={`${boxStyles.iframeTechnologies}`}>
                    <h3>Tecnologías utilizadas</h3>
                    <ul>
                        <li>Next.js 16</li>
                        <ul>
                            <li>React 19</li>
                            <li>Typescript</li>
                            <li>API Routes</li>
                        </ul>
                        <li>TailwindCSS</li>
                        <li>Cheerio.js (Web Scraping librería)</li>
                        <li>APIs oficiales</li>
                    </ul>
                    <h3>Fuentes utilizadas</h3>
                    <ul>
                        <li>Senado.gob.ar - Listado y Votaciones de Senadores</li>
                        <li>datos.hcdn.gob.ar - Listado de diputados</li>
                        <li>votaciones.hcdn.gob.ar - Votaciones de diputados</li>
                    </ul>
                    <li>GNEWS API - Noticias por legislador</li>
                </div>
            </div>
        </div>

    </div>
</div>