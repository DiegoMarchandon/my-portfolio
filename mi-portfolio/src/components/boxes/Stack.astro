---
import styles from '../../styles/boxes/stack.module.css';
import StackComponent from '../reactComponents/StackComponent';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const { locale } = Astro.props as { locale: Locale };

const categories = t(locale, 'stack.categories');
---

<div id="stack" class={styles.boxContainer}>
    <h1 class={styles.stackTitle}>{t(locale, 'stack.title')}</h1>
    <p class={styles.stackSubtitle}>{t(locale, 'stack.subtitle')}</p>

    <div class={styles.stackGrid}>
        {categories.map((cat: { title: string; description: string; technologies: string[] }) => (
            <StackComponent
                title={cat.title}
                description={cat.description}
                technologies={cat.technologies}
            />
        ))}
    </div>
</div>