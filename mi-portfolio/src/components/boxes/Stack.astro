---
import styles from '../../styles/boxes.module.css';
import boxStyles from '../../styles/boxes/stack.module.css';
import StackComponent from '../reactComponents/StackComponent';
---

<div class={`${boxStyles.boxContainer} ${styles.boxStyles}`}>
    <h1 class={`${styles.MainText} ${styles.StackMainText}`}>Mi Stack tecnológico</h1>
    <p class={`${styles.subText} ${styles.StackSubText}`}>Herramientas con las que acostumbro trabajar y tengo conocimientos</p class={styles.subText}>
    <StackComponent
        title="Stack Principal"
        description="Inlcuye tecnologías con las que más me acostumbré a trabajar."
        technologies={[
            "JavaScript",
            "React",
            "Tailwind",
            "Supabase (PostgreSQL)",
            "Vercel"
        ]}
    />

    <StackComponent
        title="Frontend & UI Engineering"
        description="Incluye todo lo que corre el cliente + frameworks de render + UI/UX."
        technologies={[
            "Typescript",
            "jQuery",
            "Bootstrap",
            "Tailwind",
            "React",
            "Next",
            "Astro"
        ]}
    />

    <StackComponent
        title="Backend, APIs & Data"
        description="incluye todo lo relacionado a la lógica del servidor, datos y APIs."
        technologies={[
            "AJAX",
            "PHP",
            "Laravel",
            "Node.js",
            "Express.js"
        ]}
    />

    <StackComponent
        title="Cloud, DevOps & Automatización"
        description="Todo lo que tenga que ver con despliegue, infraestructura y pipelines."
        technologies={[
            "AWS Cloud",
            "Docker",
            "Vercel",
            "N8N",
            "CLI",
            "XAMPP"
        ]}
    />

    <StackComponent
        title="Desarrollo móvil"
        description="Incluye las tecnologías que conozco y he utilizado para desarrollar aplicaciones móviles."
        technologies={[
            "Android Studio",
            "Expo",
            "React Native",
            "Flutter",
            "Xcode"
        ]}
    />



    <!-- 
        🧩 Consejo final de portfolio

        Tu portfolio no solo debe listar tecnologías, sino contar qué sabés hacer con ellas.
        Por ejemplo, en vez de:
        “Node.js”
        podrías poner:
        “Desarrollo de APIs REST escalables con Node.js y Express”
        Eso aumenta muchísimo tu valor percibido.
    -->
</div>