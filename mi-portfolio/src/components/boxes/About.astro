---
import CertificateComponent from '../boxesComponent/CertificateComponent';
import boxStyles from '../../styles/boxes/about.module.css';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const { locale } = Astro.props as { locale: Locale };

const items = t(locale, 'about.items');
const softSkillIcons = ['💬', '🎯', '⚡', '🤝', '🏅'];

const firstCertificatesLabels = {
    certificationTitle:{es:'Certificados de inglés',en:'English certificates',pt:'certificados de inglês'},
    certificationInfo:{es:['1st. Adults (3 meses)','2nd. Adults (3 meses)','3rd. Adults (3 meses)'],
        en:['1st. Adults (3 months)','2nd. Adults (3 months)','3rd. Adults (3 months)'],
        pt:['1st. Adults (3 meses)','2nd. Adults (3 meses)','3rd. Adults (3 meses)']
    }
}

const secondCertificateLabels = {
    certificationTitle:{es:'Certificados de actividades Universitarias',en:'University activity certificates',pt:'Certificados de atividades universitárias'},
    certificationInfo:{es:['Dictado de Cursos en Escuelas Secundarias','Coordinador en evento de Internet Seguro 2025','Taller de Construcción de Apps Móviles'],
        en:['Teaching Courses in High Schools','Coordinator at Internet Seguro 2025 event','Mobile App Development Workshop'],
        pt:['Ministrando cursos em escolas de ensino médio','Coordenador do evento Internet Seguro 2025','Oficina de desenvolvimento de aplicativos móveis']
    }
}

---

<div id="sobre-mi">

    <div class={boxStyles.timelineSection}>
        <h1 class={boxStyles.timelineMainTitle}>{t(locale, 'about.title')}</h1>

        <div class={boxStyles.timeline}>
            <div class={boxStyles.timelineLine}></div>

            {items.map((item: any, index: number) => (
                <div class={boxStyles.timelineItem}>
                    <div class={boxStyles.dotWrap}><div class={boxStyles.dot}></div></div>
                    <div class={boxStyles.tlContent}>
                        <div class={boxStyles.itemHeader}>
                            <p class={boxStyles.itemTitle}>{item.title}</p>
                            <span class={boxStyles.itemYear}>{item.year}</span>
                        </div>

                        {item.softSkills ? (
                            <div class={boxStyles.becaGrid}>
                                <p class={boxStyles.itemBody}>{item.body}</p>
                                <div class={boxStyles.softSkills}>
                                    <p class={boxStyles.softSkillsTitle}>{item.softSkillsTitle}</p>
                                    {item.softSkills.map((skill: string, i: number) => (
                                        <div class={boxStyles.skillTag}>
                                            <span class={boxStyles.skillIcon}>{softSkillIcons[i]}</span>
                                            {skill}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <p class={boxStyles.itemBody}>{item.body}</p>
                        )}
                    </div>
                </div>
            ))}
        </div>
    </div>

    <div style="display:flex; flex-direction: column; align-items: center;">
        <h2>{t(locale, 'about.certificationsTitle')}</h2>
        <div class={`${boxStyles.CertificatesContainer}`}>
            <CertificateComponent
                client:load
                locale={locale}
                thumbnail={'/thumbnails/ThumbnailCertificadoIngles.png'}
                certificadoTitle={firstCertificatesLabels.certificationTitle[locale]}
                certificadoInfo={firstCertificatesLabels.certificationInfo[locale]}
                pdfPath={'/pdfs/certificado-ingles.pdf'}
            />
            <CertificateComponent
                client:load
                locale={locale}
                thumbnail={'/thumbnails/ThumbnailBecaPPU.png'}
                certificadoTitle={secondCertificateLabels.certificationTitle[locale]}
                certificadoInfo={secondCertificateLabels.certificationInfo[locale]}
                pdfPath={'/pdfs/certificado-beca.pdf'}
            />
        </div>
    </div>

</div>