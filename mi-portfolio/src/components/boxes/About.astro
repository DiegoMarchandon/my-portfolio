---
import CertificateComponent from '../boxesComponent/CertificateComponent';
import boxStyles from '../../styles/boxes/about.module.css';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const { locale } = Astro.props as { locale: Locale };

const items = t(locale, 'about.items');
const softSkillIcons = ['💬', '🎯', '⚡', '🤝', '🏅'];
---

<div id="sobre-mi">

    <div class={boxStyles.timelineSection}>
        <h1 class={boxStyles.timelineMainTitle}>{t(locale, 'about.title')}</h1>

        <div class={boxStyles.timeline}>
            <div class={boxStyles.timelineLine}></div>

            {items.map((item: any, index: number) => (
                <div class={boxStyles.timelineItem}>
                    <div class={boxStyles.dotWrap}><div class={boxStyles.dot}></div></div>
                    <div class={boxStyles.tlContent}>
                        <div class={boxStyles.itemHeader}>
                            <p class={boxStyles.itemTitle}>{item.title}</p>
                            <span class={boxStyles.itemYear}>{item.year}</span>
                        </div>

                        {item.softSkills ? (
                            <div class={boxStyles.becaGrid}>
                                <p class={boxStyles.itemBody}>{item.body}</p>
                                <div class={boxStyles.softSkills}>
                                    <p class={boxStyles.softSkillsTitle}>{item.softSkillsTitle}</p>
                                    {item.softSkills.map((skill: string, i: number) => (
                                        <div class={boxStyles.skillTag}>
                                            <span class={boxStyles.skillIcon}>{softSkillIcons[i]}</span>
                                            {skill}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <p class={boxStyles.itemBody}>{item.body}</p>
                        )}
                    </div>
                </div>
            ))}
        </div>
    </div>

    <div style="display:flex; flex-direction: column; align-items: center;">
        <h2>{t(locale, 'about.certificationsTitle')}</h2>
        <div class={`${boxStyles.CertificatesContainer}`}>
            <CertificateComponent
                client:load
                locale={locale}
                thumbnail={'/thumbnails/ThumbnailCertificadoIngles.png'}
                certificadoTitle={locale === 'es' ? 'Certificados de inglés' : 'English certificates'}
                certificadoInfo={['1st. Adults (3 meses)','2nd. Adults (3 meses)','3rd. Adults (3 meses)']}
                pdfPath={'/pdfs/certificado-ingles.pdf'}
            />
            <CertificateComponent
                client:load
                locale={locale}
                thumbnail={'/thumbnails/ThumbnailBecaPPU.png'}
                certificadoTitle={locale === 'es' ? 'Certificados de actividades Universitarias' : 'University activity certificates'}
                certificadoInfo={locale === 'es'
                    ? ['Dictado de Cursos en Escuelas Secundarias','Coordinador en evento de Internet Seguro 2025','Taller de Construcción de Apps Móviles']
                    : ['Teaching Courses in High Schools','Coordinator at Internet Seguro 2025 event','Mobile App Development Workshop']}
                pdfPath={'/pdfs/certificado-beca.pdf'}
            />
        </div>
    </div>

</div>