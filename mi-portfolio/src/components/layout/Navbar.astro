---
import styles from './../../styles/navbar.module.css';

/* código javascript dentro del frontmatter (entre ---) */
const links = [
  {href: "#presentacion", label: "PRESENTACIÓN"},
  {href: "#stack", label: "STACK"},
  {href: "#proyectos", label: "PROYECTOS"},
  {href: "#sobre-mi", label: "SOBRE MI"},
];
--- 

<!-- Poner una animación debajo del Navbar que de una línea horizontal que se vaya llenando en base a la cantidad de contenido que le falta por ver -->

<nav class={styles.navStyles}>
    <div class={styles.navChild}>
        <h2 id={styles.myNameHome}>DIEGO <span class={styles.lastNameStyles}>MARCHANDON</span></h2>
    </div>
    <div class={styles.navChild}>
      <ul class={styles.ulStyles}>
      {links.map(link => (
          <li class={styles.liStyles}>
            <a class={styles.aStyles} href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
  </div>
</nav>