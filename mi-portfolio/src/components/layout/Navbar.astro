---
import styles from './../../styles/navbar.module.css';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const { locale } = Astro.props as { locale: Locale };

const links = [
    { href: `/${locale}/#presentacion`, label: t(locale, 'nav.presentacion') },
    { href: `/${locale}/#stack`,        label: t(locale, 'nav.stack') },
    { href: `/${locale}/#proyectos`,    label: t(locale, 'nav.proyectos') },
    { href: `/${locale}/#sobre-mi`,     label: t(locale, 'nav.sobreMi') },
];

const localeSwitch = {
    es: {next:'en',label:'EN'},
    en: {next: 'pt',label: 'PT'},
    pt: {next: 'es',label: 'ES'},
} as const;

// const otherLocale = locale === 'es' ? 'en' : 'es';
// const otherLocaleLabel = locale === 'es' ? 'EN' : 'ES';
const {next: otherLocale, label: otherLocaleLabel} = localeSwitch[locale];

---

<nav class={styles.navStyles}>
    <div class={styles.navChild}>
        <h2 id={styles.myNameHome}>DIEGO <span class={styles.lastNameStyles}>MARCHANDON</span></h2>
    </div>

    <button class={styles.hamburger} id="hamburger-btn" aria-label="Abrir menú" aria-expanded="false">
        <span class={styles.bar}></span>
        <span class={styles.bar}></span>
        <span class={styles.bar}></span>
    </button>

    <div class={styles.navChild} id="nav-menu">
        <ul class={styles.ulStyles}>
            {links.map(link => (
                <li class={styles.liStyles}>
                    <a class={styles.aStyles} href={link.href}>{link.label}</a>
                </li>
            ))}
            <li class={styles.liStyles}>
                <a class={`${styles.aStyles} ${styles.localeSwitcher}`} href={`/${otherLocale}/`}>
                    {otherLocaleLabel}
                </a>
            </li>
        </ul>
    </div>
</nav>

<script>
    const btn = document.getElementById('hamburger-btn');
    const menu = document.getElementById('nav-menu');

    btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    document.querySelectorAll('#nav-menu a').forEach(link => {
        link.addEventListener('click', () => {
            menu?.classList.remove('open');
            btn?.setAttribute('aria-expanded', 'false');
        });
    });
</script>